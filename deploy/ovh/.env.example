# Copier en deploy/ovh/.env puis remplir. Ce fichier contient des secrets : ne jamais le committer.
# Mots de passe : uniquement lettres et chiffres (ils sont placés dans une URI), par ex. `openssl rand -hex 24`.

# Domaine de l'API, pointant vers l'IP du serveur. Sans nom de domaine : <ip-avec-tirets>.sslip.io
API_DOMAIN=145-239-80-211.sslip.io

# Administrateur MongoDB (sauvegardes, restauration).
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=

# Utilisateur de l'API (lecture/écriture sur worldcup2026 seulement).
MONGO_APP_USER=heimdall
MONGO_APP_PASSWORD=

# Clé de signature des sessions : reprendre celle de Render pour ne déconnecter personne.
AUTH_SECRET=

# Adresse(s) du frontend autorisées à appeler l'API, séparées par des virgules.
ALLOWED_ORIGINS=https://dashboard-git-main-musoc-lens.vercel.app

# Surveillance (docs/deploiement.md, « Surveillance et alertes ») : adresses de ping Healthchecks.io.
# monitor.sh (toutes les 5 min) et backup.sh (chaque nuit). Vides : pas d'alerte.
HC_MONITOR_URL=
HC_BACKUP_URL=
# Seuils de monitor.sh (valeurs par défaut).
# MONITOR_DISK_MAX_PERCENT=85
# MONITOR_MEMORY_MIN_MB=300
# MONITOR_CERT_MIN_DAYS=14
# MONITOR_BACKUP_MAX_HOURS=26
