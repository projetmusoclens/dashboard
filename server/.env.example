PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=worldcup2026
ARCHIVE_DB_NAME=wc2026_archive# Clé de signature des sessions (longue chaîne aléatoire, secrète). Sans elle, les sessions sont perdues à chaque redémarrage.
AUTH_SECRET=
# Premier administrateur, créé au démarrage uniquement si aucun compte n'existe encore.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_NAME=
# Origines autorisées par CORS, séparées par des virgules (vide = toutes)
ALLOWED_ORIGINS=
